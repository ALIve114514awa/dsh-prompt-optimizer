{
  "name": "dsh-prompt-optimizer",
  "version": "0.1.3",
  "description": "Preview and improve your DeepSeek Harness draft with Harness AI or Codex.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALIve114514awa/dsh-prompt-optimizer.git"
  },
  "homepage": "https://github.com/ALIve114514awa/dsh-prompt-optimizer#readme",
  "bugs": {
    "url": "https://github.com/ALIve114514awa/dsh-prompt-optimizer/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/host/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/server/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./tui": {
      "types": "./lib/types/host/tui/index.d.ts",
      "default": "./lib/tui.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./tui.patch.yml": "./tui.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "lib/tui.js",
    "lib/tui.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "tui.patch.yml",
    "locale/*.json",
    "docs/*.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "node scripts/build.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:registration": "node scripts/verify-runtime-registration.mjs",
    "verify:client": "node scripts/verify-client-behavior.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:package && npm run verify:registration && npm run verify:client",
    "pack:artifact": "node scripts/pack.mjs",
    "pack:tui": "node scripts/pack-tui.mjs",
    "prepack": "npm run build && npm run verify:package"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "react": "18.3.1 || ^19.0.0",
    "@deepseek-harness-tui/dsh-tui": "0.11.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-harness-tui/dsh-tui": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "immer": "^10.1.1",
    "react": "18.3.1",
    "semver": "^7.8.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "zustand": "~4.4.7"
  }
}
