{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "outDir": "lib/types/host",
    "tsBuildInfoFile": "lib/.host.tsbuildinfo"
  },
  "include": ["src/server/**/*.ts", "src/shared/**/*.ts", "src/tui/**/*.ts", "src/tui/**/*.tsx"],
  "exclude": ["src/client", "node_modules", "lib", "tests"]
}
